# Database Connection (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:root@localhost:5432/college_resource_hub?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-12345
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Redis / BullMQ Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage Configuration
STORAGE_DRIVER=local
STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE_MB=50
